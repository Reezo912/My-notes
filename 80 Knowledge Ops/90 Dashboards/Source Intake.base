filters:
  and:
    - file.ext == "md"
    - domain == "knowledge-ops"
    - type == "source"
properties:
  file.name:
    displayName: Note
  file.folder:
    displayName: Folder
  source_kind:
    displayName: Source Kind
  knowledge_state:
    displayName: Knowledge State
  review_state:
    displayName: Review State
  target_domains:
    displayName: Target Domains
  last_reviewed:
    displayName: Last Reviewed
views:
  - type: table
    name: By Source Kind
    groupBy:
      property: source_kind
      direction: ASC
    order:
      - source_kind
      - knowledge_state
      - file.name
  - type: table
    name: By Review State
    groupBy:
      property: review_state
      direction: ASC
    order:
      - review_state
      - source_kind
      - file.name
