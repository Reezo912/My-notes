filters:
  and:
    - file.ext == "md"
    - type
properties:
  file.name:
    displayName: Note
  file.folder:
    displayName: Folder
  domain:
    displayName: Domain
  type:
    displayName: Type
  status:
    displayName: Status
  knowledge_state:
    displayName: Knowledge State
  review_state:
    displayName: Review State
  source_kind:
    displayName: Source Kind
  audience:
    displayName: Audience
  last_reviewed:
    displayName: Last Reviewed
views:
  - type: table
    name: Review Queue
    order:
      - last_reviewed
      - domain
      - type
      - file.name
  - type: table
    name: Bridge Notes
    filters: type == "bridge"
    groupBy:
      property: domain
      direction: ASC
    order:
      - domain
      - file.name
  - type: table
    name: By Status
    groupBy:
      property: status
      direction: ASC
    order:
      - status
      - last_reviewed
      - file.name
  - type: table
    name: Guides And Indexes
    filters:
      or:
        - type == "guide"
        - type == "index"
    groupBy:
      property: type
      direction: ASC
    order:
      - type
      - domain
      - file.name
  - type: table
    name: Knowledge Ops Review
    filters: domain == "knowledge-ops"
    order:
      - review_state
      - knowledge_state
      - file.name
